# Out-of-tree QEMU sim build. Kept separate (with its own SDKCONFIG) so
# checking the sim config compiles doesn't clobber the real sdkconfig:
#   idf.py -B build-qemu -D SDKCONFIG="build-qemu/sdkconfig" \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.ci.qemu" build
build-qemu/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
.vscode/
.idea/
*.log
