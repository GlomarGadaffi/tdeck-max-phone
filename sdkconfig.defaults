# Target configuration
CONFIG_IDF_TARGET="esp32s3"

# Flash settings (16MB Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# PSRAM settings (8MB QUAD PSRAM -- NOT Octal).
#
# This was previously CONFIG_SPIRAM_MODE_OCT=y, which is wrong for this
# board: LilyGO's own board definition for the T-Deck MAX
# (github.com/Xinyuan-LilyGO/T-Deck-MAX boards/T-Deck-Pro.json) specifies
# "memory_type": "qio_qspi" and names the board "... 8M QSPI PSRAM" --
# Quad, not Octal. On the ESP32-S3, octal PSRAM/flash consumes GPIO 33-37
# for the extra data lines, which this board's pinmap uses for real
# peripherals (MOSI 33, EPD_CS 34, EPD_DC 35, SCK 36, EPD_BUSY 37) --
# running in octal mode would have stolen those pins out from under the
# e-paper/LoRa/SD SPI bus and I2S MCLK (38), with a maximally confusing
# failure mode (everything on that bus dying at once). Caught in review
# before first flash, not found by QEMU (sdkconfig.ci.qemu disables
# PSRAM entirely, so it never exercised this).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# CPU Clock Frequency
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# FreeRTOS Core pinning & clock tick
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_NUMBER_OF_CORES=2

# Main task stack. The default (3584) is NOT enough for the SIP layer and
# overflows the moment registerExt() runs: it holds char rbuf[2048] live
# across its receive loop, and the builders/parser add char msg[1280] plus
# SipMessage frames on top. Confirmed on hardware as
# "***ERROR*** A stack overflow in task main has been detected." right
# after the first REGISTER, boot-looping the device.
#
# 8192 matches what the sibling tincan project already sets for the same
# code -- the buffers were ported from there, this setting was not.
# The audio and e-paper tasks size their own stacks in app_main.cpp.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# LWIP Socket & Networking
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVTIMEO=y
CONFIG_LWIP_IP4_REASSEMBLY=y
CONFIG_LWIP_IP4_FRAG=y

# NVS
CONFIG_NVS_ENCRYPTION=n

# Compiler Optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# C++ exceptions -- the vendored pocket-dial SIP parser (components/sip_core,
# ported from tincan) uses them.
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=y

# ── LVGL 8.3.x (managed component), configured through Kconfig rather than
# a checked-in lv_conf.h -- the convention of the sibling tdeck-glopanel /
# glopanel projects, whose e-paper flush design lvgl_glue.c carries over.
CONFIG_LV_CONF_SKIP=y
# Monochrome: 1 byte/pixel in LVGL's software buffer, packed to the panel's
# 1 bit/pixel in the flush callback; pulls in LV_USE_THEME_MONO.
CONFIG_LV_COLOR_DEPTH_1=y
CONFIG_LV_TICK_CUSTOM=n
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y
CONFIG_LV_INDEV_DEF_READ_PERIOD=30
CONFIG_LV_DISP_DEF_REFR_PERIOD=30

# ── Crash forensics. The main task (SIP control + LVGL pump) is under the
# task watchdog; a trip becomes a panic + core dump to the "coredump"
# partition (partitions.csv) instead of a silent hang.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# ── Status-bar clock: SNTP. NIST asks for long polling intervals.
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# Home + dialer + call + incoming can be live at once, plus a full contacts
# list; the 32 KB default was never exercised under that load.
CONFIG_LV_MEM_SIZE_KILOBYTES=64
