#pragma once
// ─────────────────────────────────────────────────────────────────────────
//  LOCAL SECRETS TEMPLATE -- copy to poc_secrets.h and fill in.
//
//      cp main/include/poc_secrets.h.example main/include/poc_secrets.h
//
//  poc_secrets.h is gitignored and must NEVER be committed. This .example
//  file IS tracked, so keep placeholder values here only.
//
//  Anything defined here overrides the default in poc_config.h (which
//  guards every site-specific setting with #ifndef). Define only what you
//  need to change -- omitted settings fall back to the defaults.
// ─────────────────────────────────────────────────────────────────────────

// Wi-Fi STA credentials.
#define POC_WIFI_SSID        "your-ssid"
#define POC_WIFI_PASS        "your-password"

// drawbridge SIP server (registrar/PBX) on the LAN.
// Must be in its OPEN/self-registering registrar mode: this firmware has no
// SIP digest auth and treats a 401 challenge as a rejection (see issue #28).
#define POC_SIP_SERVER_IP    "192.168.1.10"
// #define POC_SIP_SERVER_PORT  5060

// This device's extension. Any free number -- drawbridge self-registers it.
// #define POC_SIP_EXT_SELF     "1002"

// Registration lifetime in seconds. maintainRegistration() refreshes at
// half this value, so lowering it is a quick way to bench-test the refresh
// path (issue #24) without waiting an hour.
// #define POC_SIP_REG_EXPIRES  3600
